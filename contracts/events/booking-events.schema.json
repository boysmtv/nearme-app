{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.dekat.id/schemas/events/booking-events.json",
  "definitions": {
    "booking_status": {
      "type": "string",
      "enum": ["pending", "confirmed", "in_progress", "completed", "cancelled", "rescheduled"]
    },
    "booking_data": {
      "type": "object",
      "required": ["id", "booking_code", "status", "service", "customer", "pricing", "scheduled_at", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "booking_code": {"type": "string"},
        "status": {"$ref": "#/definitions/booking_status"},
        "service": {
          "type": "object",
          "required": ["id", "name", "category"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "name": {"type": "string"},
            "category": {"type": "string"},
            "duration_minutes": {"type": "integer", "minimum": 1}
          }
        },
        "provider": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "name": {"type": "string"}
          }
        },
        "staff": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "name": {"type": "string"}
          }
        },
        "customer": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "name": {"type": "string"},
            "phone": {"type": "string"},
            "email": {"type": "string", "format": "email"}
          }
        },
        "pricing": {
          "type": "object",
          "required": ["total_amount", "currency"],
          "properties": {
            "base_amount": {"type": "number", "minimum": 0},
            "discount_amount": {"type": "number", "minimum": 0},
            "tax_amount": {"type": "number", "minimum": 0},
            "total_amount": {"type": "number", "minimum": 0},
            "currency": {"type": "string", "default": "IDR"}
          }
        },
        "scheduled_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "cancelled_at": {"type": "string", "format": "date-time"},
        "cancellation_reason": {"type": "string"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "oneOf": [
    {
      "$id": "https://api.dekat.id/schemas/events/booking.created.json",
      "description": "Emitted when a new booking is created",
      "type": "object",
      "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "tenant_id", "aggregate_type", "aggregate_id", "data"],
      "properties": {
        "event_type": {"const": "booking.created"},
        "event_version": {"const": 1},
        "aggregate_type": {"const": "booking"},
        "data": {"$ref": "#/definitions/booking_data"}
      }
    },
    {
      "$id": "https://api.dekat.id/schemas/events/booking.confirmed.json",
      "description": "Emitted when a booking is confirmed by the provider",
      "type": "object",
      "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "tenant_id", "aggregate_type", "aggregate_id", "data"],
      "properties": {
        "event_type": {"const": "booking.confirmed"},
        "event_version": {"const": 1},
        "aggregate_type": {"const": "booking"},
        "data": {"$ref": "#/definitions/booking_data"}
      }
    },
    {
      "$id": "https://api.dekat.id/schemas/events/booking.cancelled.json",
      "description": "Emitted when a booking is cancelled",
      "type": "object",
      "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "tenant_id", "aggregate_type", "aggregate_id", "data"],
      "properties": {
        "event_type": {"const": "booking.cancelled"},
        "event_version": {"const": 1},
        "aggregate_type": {"const": "booking"},
        "data": {
          "allOf": [
            {"$ref": "#/definitions/booking_data"},
            {
              "type": "object",
              "required": ["cancelled_at", "cancellation_reason"],
              "properties": {
                "cancelled_at": {"type": "string", "format": "date-time"},
                "cancellation_reason": {"type": "string"}
              }
            }
          ]
        }
      }
    },
    {
      "$id": "https://api.dekat.id/schemas/events/booking.completed.json",
      "description": "Emitted when a booking service is completed",
      "type": "object",
      "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "tenant_id", "aggregate_type", "aggregate_id", "data"],
      "properties": {
        "event_type": {"const": "booking.completed"},
        "event_version": {"const": 1},
        "aggregate_type": {"const": "booking"},
        "data": {
          "allOf": [
            {"$ref": "#/definitions/booking_data"},
            {
              "type": "object",
              "required": ["completed_at"],
              "properties": {
                "completed_at": {"type": "string", "format": "date-time"}
              }
            }
          ]
        }
      }
    },
    {
      "$id": "https://api.dekat.id/schemas/events/booking.rescheduled.json",
      "description": "Emitted when a booking is rescheduled to a new time",
      "type": "object",
      "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "tenant_id", "aggregate_type", "aggregate_id", "data"],
      "properties": {
        "event_type": {"const": "booking.rescheduled"},
        "event_version": {"const": 1},
        "aggregate_type": {"const": "booking"},
        "data": {
          "allOf": [
            {"$ref": "#/definitions/booking_data"},
            {
              "type": "object",
              "required": ["previous_scheduled_at"],
              "properties": {
                "previous_scheduled_at": {"type": "string", "format": "date-time"},
                "reschedule_reason": {"type": "string"}
              }
            }
          ]
        }
      }
    }
  ]
}
