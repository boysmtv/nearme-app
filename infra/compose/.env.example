# ═══════════════════════════════════════════════════════════════
# DEKAT Booking Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env files.
# ═══════════════════════════════════════════════════════════════

# ─── Container Registry ──────────────────────────────────────
REGISTRY=ghcr.io
ORG=dekat

# ─── Image Tags ──────────────────────────────────────────────
WEB_PUBLIC_TAG=latest
WEB_PROVIDER_TAG=latest
WEB_ADMIN_TAG=latest
API_TAG=latest
WORKER_TAG=latest

# ─── Spring Profiles ─────────────────────────────────────────
SPRING_PROFILES=prod

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=dekat
POSTGRES_USER=dekat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── PgBouncer ───────────────────────────────────────────────
PGBOUNCER_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=200

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Kafka ───────────────────────────────────────────────────
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NUM_PARTITIONS=6

# ─── MinIO (Object Storage) ─────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BROWSER_URL=http://localhost:9001

# ─── Java Options ────────────────────────────────────────────
API_JAVA_OPTS=-Xms512m -Xmx1024m
WORKER_JAVA_OPTS=-Xms512m -Xmx1024m

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_PORT=3001

# ─── Domain / URLs ───────────────────────────────────────────
DOMAIN=dekat.id
PUBLIC_DOMAIN=app.dekat.id
PROVIDER_DOMAIN=provider.dekat.id
ADMIN_DOMAIN=admin.dekat.id
API_DOMAIN=api.dekat.id

# ─── Payment Gateway (Midtrans) ─────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_WEBHOOK_SECRET=SB-Mid-signature-key-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_API_URL=https://api.midtrans.com

# ─── Firebase Cloud Messaging ───────────────────────────────
FCM_PROJECT_ID=dekat-prod
FCM_SERVICE_ACCOUNT_PATH=./fcm/service-account.json

# ─── JWT Secrets ────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS
